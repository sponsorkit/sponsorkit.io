<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>Sponsorkit</RootNamespace>
    <AssemblyName>Sponsorkit</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Sponsorkit</PackageId>
    <Title>Sponsorkit</Title>
    <Description>Build financial contributions (GitHub Sponsors, Open Collective) directly into your .NET app: check what the current user contributes, open a checkout, and nag politely. No account, no keys, no setup.</Description>
    <PackageTags>sponsorkit;sponsors;github-sponsors;opencollective;open-source;funding;donations</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="MockPresets.json" LogicalName="Sponsorkit.MockPresets.json" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Sponsorkit.Tests" />
  </ItemGroup>

</Project>
