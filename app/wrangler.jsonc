{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sponsorkit",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // API-only Worker (PROTOCOL §0): /api/v1/* and /api/oauth/* on its own custom domain. The site
  // (web/, static export) is on GitHub Pages; this Worker serves no static assets.
  // Requires the sponsorkit.io zone on the Cloudflare account. To use another hostname, change this
  // route, PUBLIC_ORIGIN below and both OAuth apps' callback URLs together.
  "routes": [{ "pattern": "api.sponsorkit.io", "custom_domain": true }],

  // Workers Rate Limiting bindings. The code treats a missing binding as "no limit".
  // namespace_id values only need to be unique within the Cloudflare account.
  "ratelimits": [
    // /api/v1/auth/* and /api/oauth/*: 30 requests / 60 s per client IP.
    { "name": "RL_AUTH", "namespace_id": "4201", "simple": { "limit": 30, "period": 60 } },
    // /api/v1/contributions: 1 refresh / 60 s per session (hash of target set + identities).
    { "name": "RL_REFRESH", "namespace_id": "4202", "simple": { "limit": 1, "period": 60 } },
    // All /api/*: 120 requests / 60 s per client IP.
    { "name": "RL_IP", "namespace_id": "4203", "simple": { "limit": 120, "period": 60 } },
    // /api/v1/contributions: 60 requests / 60 s per client IP (SPEC §8).
    { "name": "RL_CONTRIB_IP", "namespace_id": "4204", "simple": { "limit": 60, "period": 60 } },
    // /api/v1/targets cache misses (each one spends the shared GITHUB_METADATA_TOKEN quota of
    // 5,000 GraphQL points/hour): 20 / 60 s per client IP ...
    { "name": "RL_TARGETS_MISS", "namespace_id": "4205", "simple": { "limit": 20, "period": 60 } },
    // ... and 60 / 60 s in total (one key), i.e. at most 3,600/hour per location.
    { "name": "RL_TARGETS_MISS_GLOBAL", "namespace_id": "4206", "simple": { "limit": 60, "period": 60 } }
  ],

  // Invocation logs would record full request URLs, and the OAuth callback's query string
  // carries the provider code and sealed state (SPEC §9: logs never contain codes). Only the
  // app's own structured logs (path only) are kept.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },

  // Secrets (set with `wrangler secret put <NAME>`; see .dev.vars.example):
  // GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, OPENCOLLECTIVE_CLIENT_ID,
  // OPENCOLLECTIVE_CLIENT_SECRET, SEALING_KEYS, PAIRWISE_KEY, GITHUB_METADATA_TOKEN
  // Public configuration (PROTOCOL §0.1). Trailing slashes are trimmed. SITE_ORIGIN must be the
  // bare origin of SITE_BASE_URL, otherwise sign-in fails closed. Single-origin self-hosting:
  // set SITE_ORIGIN (and SITE_BASE_URL) to the API origin, or leave both unset.
  "vars": {
    // The API origin: OAuth callback URLs are <PUBLIC_ORIGIN>/api/oauth/<provider>/callback.
    "PUBLIC_ORIGIN": "https://api.sponsorkit.io",
    // Site base URL: sign-in deliveries (/connect/done/), consent links and problem `type` URLs.
    "SITE_BASE_URL": "https://sponsorkit.github.io/sponsorkit.io",
    // The only Origin accepted by POST /api/oauth/:provider/start.
    "SITE_ORIGIN": "https://sponsorkit.github.io"
  }
}
