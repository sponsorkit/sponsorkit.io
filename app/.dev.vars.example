# Copy to app/.dev.vars for `wrangler dev`. In production set each with `wrangler secret put <NAME>`.
# Never commit real values.

# GitHub OAuth App (callback URL: <PUBLIC_ORIGIN>/api/oauth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Open Collective OAuth app (callback URL: <PUBLIC_ORIGIN>/api/oauth/opencollective/callback)
OPENCOLLECTIVE_CLIENT_ID=
OPENCOLLECTIVE_CLIENT_SECRET=

# Sealing keys for state, sign-in codes and session tokens (AES-256-GCM).
# JSON array of { id, key }: id is an integer 0-255, key is 32 random bytes as base64url.
# The FIRST entry seals; all entries unseal (rotation: add new key first, drop old after 180 days).
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SEALING_KEYS=[{"id":1,"key":"<32 bytes base64url>"}]

# HMAC key for pairwise supporter ids (any high-entropy string, used as UTF-8 bytes).
# Changing it changes every supporter.id.
PAIRWISE_KEY=

# GitHub token used ONLY to read public Sponsors listings for GET /api/v1/targets
# (a fine-grained PAT with no permissions is enough). Never used for supporter data.
GITHUB_METADATA_TOKEN=

# Public configuration (PROTOCOL §0.1). These are plain vars, not secrets: production values are in
# wrangler.jsonc "vars". Values in .dev.vars override them for `wrangler dev`.
#
# PUBLIC_ORIGIN: the API origin, used to build OAuth callback URLs (unset: the request's origin).
# SITE_BASE_URL: where the site lives (origin + base path); deliveries go to <SITE_BASE_URL>/connect/done/,
#   consent links to <SITE_BASE_URL>/connect/ and /checkout/ (unset: PUBLIC_ORIGIN, i.e. single origin).
# SITE_ORIGIN: the only Origin accepted by POST /api/oauth/:provider/start; must be the bare origin of
#   SITE_BASE_URL (unset: derived from SITE_BASE_URL).
#
# Local development with the site on `next dev` (http://localhost:3000) and the Worker on wrangler dev
# (http://localhost:8787). Note the __Host- nonce cookie needs a secure context; localhost counts.
# PUBLIC_ORIGIN=http://localhost:8787
# SITE_BASE_URL=http://localhost:3000
# SITE_ORIGIN=http://localhost:3000
#
# Single-origin self-hosting (site and API behind one origin):
# PUBLIC_ORIGIN=https://sponsorkit.example.com
# SITE_BASE_URL=https://sponsorkit.example.com
# SITE_ORIGIN=https://sponsorkit.example.com

# Optional provider base URL overrides (tests / self-hosting):
# GITHUB_OAUTH_BASE=https://github.com
# GITHUB_API_BASE=https://api.github.com
# OPENCOLLECTIVE_BASE=https://opencollective.com
# OPENCOLLECTIVE_API_BASE=https://api.opencollective.com
