{
  "name": "@sponsorkit/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve": "node scripts/serve.mjs",
    "docs:generate": "bun scripts/docs-generate.ts",
    "docs:validate": "bun scripts/validate-generated.ts",
    "docs:check-links": "bun scripts/check-links.ts",
    "test": "vitest run",
    "test:e2e": "next build && bun scripts/check-links.ts && playwright test --trace off",
    "typecheck": "next typegen && tsc --noEmit -p ."
  },
  "dependencies": {
    "@sponsorkit/shared": "workspace:*",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/unist": "^3.0.3",
    "hast-util-to-html": "^9",
    "shiki": "^4.6.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
